@baseUrl = http://localhost:3000/api
# Cole aqui o access_token devolvido por /auth/register ou /auth/login
@token = COLE_AQUI_O_TOKEN

# O Profile é criado automaticamente em POST /auth/register.
# Não existe mais POST /profiles.

### Buscar meu perfil
GET {{baseUrl}}/profiles/me
Authorization: Bearer {{token}}

### Atualizar meu perfil
PUT {{baseUrl}}/profiles/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "João Silva",
  "birthDate": "1990-01-15T00:00:00Z",
  "avatarUrl": "https://exemplo.com/avatar.png"
}
