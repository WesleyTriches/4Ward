generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  createdAt    DateTime @default(now())
  passwordHash String   @default("$2b$10$21V92Zk9GwSDXAdgqRr/oul1AN7/roDDo.q/eqCW35OdH1wUQDg9O")

  role   String  @default("PATIENT")
  active Boolean @default(true)

  profile Profile?
}

model Profile {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  fullName  String
  phone     String?
  birthDate DateTime?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  physiotherapist Physiotherapist?
  appointments    Appointment[]
}

model Specialty {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  icon        String?

  physiotherapists Physiotherapist[]
}

model Physiotherapist {
  id              Int     @id @default(autoincrement())
  profileId       Int     @unique
  specialtyId     Int
  crefito         String  @unique
  bio             String?
  sessionPrice    Float
  city            String
  serviceMode     String
  experienceYears Int
  rating          Float?

  profile   Profile   @relation(fields: [profileId], references: [id])
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  schedules    Schedule[]
  appointments Appointment[]
}

model Schedule {
  id                Int      @id @default(autoincrement())
  physiotherapistId Int
  dateTime          DateTime
  available         Boolean  @default(true)

  physiotherapist Physiotherapist @relation(fields: [physiotherapistId], references: [id])
  appointment     Appointment?

  @@unique([physiotherapistId, dateTime])
}

model Appointment {
  id                Int      @id @default(autoincrement())
  patientId         Int
  physiotherapistId Int
  scheduleId        Int      @unique
  status            String
  reason            String?
  price             Float
  painLevel         Int?
  sessionNotes      String?
  rescheduledFrom   Int?
  cancelledBy       String?
  cancelReason      String?
  createdAt         DateTime @default(now())

  patient         Profile         @relation(fields: [patientId], references: [id])
  physiotherapist Physiotherapist @relation(fields: [physiotherapistId], references: [id])
  schedule        Schedule        @relation(fields: [scheduleId], references: [id])

  review Review?
}

model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}
