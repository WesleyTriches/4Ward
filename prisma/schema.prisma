generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}


// ==================== ENUMS ====================

enum UserRole {
  PATIENT
  PHYSIOTHERAPIST
}

enum ServiceMode {
  IN_PERSON
  ONLINE
  BOTH
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CancellationActor {
  PATIENT
  PHYSIOTHERAPIST
}


// ==================== USER ====================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PATIENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  profile Profile?
}


// ==================== PROFILE ====================

model Profile {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  name      String
  phone     String?
  birthDate DateTime?
  photoUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  physiotherapist Physiotherapist?
  appointments    Appointment[]
}


// ==================== SPECIALTY ====================

model Specialty {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  icon        String?

  physiotherapists Physiotherapist[]
}


// ==================== PHYSIOTHERAPIST ====================

model Physiotherapist {
  id              Int         @id @default(autoincrement())
  profileId       Int         @unique
  specialtyId     Int
  crefito         String      @unique
  bio             String?
  sessionPrice    Float
  city            String
  serviceMode     ServiceMode
  experienceYears Int
  rating          Float?

  profile Profile @relation(
    fields: [profileId],
    references: [id],
    onDelete: Cascade
  )

  specialty Specialty @relation(
    fields: [specialtyId],
    references: [id]
  )

  schedules    Schedule[]
  appointments Appointment[]
}


// ==================== SCHEDULE ====================

model Schedule {
  id                Int      @id @default(autoincrement())
  physiotherapistId Int
  dateTime          DateTime
  available         Boolean  @default(true)

  physiotherapist Physiotherapist @relation(
    fields: [physiotherapistId],
    references: [id],
    onDelete: Cascade
  )

  appointment Appointment?

  @@unique([physiotherapistId, dateTime])
}


// ==================== APPOINTMENT ====================

model Appointment {
  id                Int               @id @default(autoincrement())
  patientId         Int
  physiotherapistId Int
  scheduleId        Int               @unique
  status            AppointmentStatus @default(SCHEDULED)

  reason       String?
  price        Float
  painLevel    Int?
  sessionNotes String?

  cancelledBy  CancellationActor?
  cancelReason String?

  rescheduledFromId Int? @unique

  createdAt DateTime @default(now())

  patient Profile @relation(
    fields: [patientId],
    references: [id]
  )

  physiotherapist Physiotherapist @relation(
    fields: [physiotherapistId],
    references: [id]
  )

  schedule Schedule @relation(
    fields: [scheduleId],
    references: [id]
  )

  rescheduledFrom Appointment? @relation(
    "AppointmentReschedule",
    fields: [rescheduledFromId],
    references: [id]
  )

  rescheduledTo Appointment? @relation("AppointmentReschedule")

  review Review?
}


// ==================== REVIEW ====================

model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(
    fields: [appointmentId],
    references: [id],
    onDelete: Cascade
  )
}