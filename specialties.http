@baseUrl = http://localhost:3000/api
@token = {{login.response.body.$.access_token}}

### Login (envie este primeiro)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@teste.com",
  "password": "123456"
